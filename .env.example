# Optional real agent. Keys stay server-side; model must be explicitly configured.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional explicit rates. Cost is unavailable without both, never invented.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
# Local paths. Source projects are copied; originals are never modified.
AI_WHIP_PROJECTS_ROOT=./projects
AI_WHIP_DATA_DIR=./.data
# Optional local password. Required with explicit remote mode.
AI_WHIP_AUTH_TOKEN=
AI_WHIP_ALLOW_REMOTE=false
